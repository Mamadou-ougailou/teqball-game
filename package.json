{
  "name": "teqball-game",
  "version": "0.0.1",
  "description": "3D Teqball Game - Surreal Web Version",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^6.32.0",
    "@babylonjs/gui": "^6.32.0",
    "@babylonjs/havok": "^1.3.11",
    "@babylonjs/loaders": "^6.32.0",
    "howler": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.4.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.44.0",
    "prettier": "^3.0.0",
    "terser": "^5.48.0",
    "typescript": "^5.1.6",
    "vite": "^4.5.0",
    "vitest": "^0.34.1"
  }
}
