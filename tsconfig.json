{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@systems/*": ["src/systems/*"],
      "@entities/*": ["src/entities/*"],
      "@gameplay/*": ["src/gameplay/*"],
      "@animation/*": ["src/animation/*"],
      "@vfx/*": ["src/vfx/*"],
      "@ui/*": ["src/ui/*"],
      "@audio/*": ["src/audio/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.app.json" }]
}
